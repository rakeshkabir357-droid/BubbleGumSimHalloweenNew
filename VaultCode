    -- ==================================================
    -- POTION MANAGEMENT
    -- ==================================================
    local function countByType(t)
        local n = 0
        for _, v in pairs(PotionCache) do
            if v == t then n += 1 end
        end
        return n
    end

    local function findUuidByType(t)
        for uuid, v in pairs(PotionCache) do
            if v == t then return uuid end
        end
        return nil
    end

    local function deletePotionByUuid(uuid)
        if not uuid then return false end
        local ok = pcall(function()
            Event:FireServer("DeletePotion", uuid)
        end)
        if ok then
            SessionPotionsDeleted += 1
            return true
        end
        return false
    end

    local function deleteForSpace()
        if PotionCount < Config.PotionMaxSlots then return true end
        local counts = {}
        for _, t in ipairs(Config.DeletePriority) do
            counts[t] = countByType(t)
        end
        local bestType, bestCount = nil, 0
        for _, t in ipairs(Config.DeletePriority) do
            if counts[t] > bestCount then
                bestCount = counts[t]
                bestType = t
            end
        end
        if not bestType or bestCount <= 0 then return false end
        return deletePotionByUuid(findUuidByType(bestType))
    end

    local function sweepAutoDeleteTypes()
        if not _G.HalloweenAutoDeleteEnabled then return end
        local toDelete = {}
        for uuid, t in pairs(PotionCache) do
            if Config.AutoDeleteTypes[t] then
                table.insert(toDelete, uuid)
            end
        end
        for _, uuid in ipairs(toDelete) do
            deletePotionByUuid(uuid)
        end
    end

