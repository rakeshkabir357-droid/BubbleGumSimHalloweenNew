    local DELETION_RULES = {
        { parent = "Houses",      names = { "Decoration", "SignPost" }, recursive = false },
        { parent = "Halloween26", names = { "Pump" },                  recursive = false },
        { parent = "Halloween26", names = { "Pumpkins" },              recursive = true  },
    }

    local function deleteObstructions()
        for _, rule in ipairs(DELETION_RULES) do
            local parent = workspace:FindFirstChild(rule.parent)
            if not parent then continue end
            if rule.recursive then
                local toRemove = {}
                for _, obj in ipairs(parent:GetDescendants()) do
                    for _, name in ipairs(rule.names) do
                        if obj.Name == name then
                            table.insert(toRemove, obj); break
                        end
                    end
                end
                for _, obj in ipairs(toRemove) do
                    if obj and obj.Parent then pcall(function() obj:Destroy() end) end
                end
            else
                for _, child in ipairs(parent:GetChildren()) do
                    for _, name in ipairs(rule.names) do
                        local obj = child:FindFirstChild(name)
                        if obj then pcall(function() obj:Destroy() end) end
                    end
                end
            end
        end
    end

    pcall(deleteObstructions)

    -- ==================================================
    -- UTILITIES
    -- ==================================================
    local Utils = {}

    function Utils.getHRP(timeout)
        local char = player.Character or player.CharacterAdded:Wait()
        return char:WaitForChild("HumanoidRootPart", timeout or 10)
    end

    function Utils.positionOf(inst)
        if not inst then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            if inst.PrimaryPart then return inst.PrimaryPart.Position end
            local ok, pivot = pcall(function() return inst:GetPivot().Position end)
            if ok then return pivot end
        end
        return nil
    end

    function Utils.teleportTo(target, heightOffset)
        local hrp = Utils.getHRP()
        if not hrp or not target then return false end
        heightOffset = heightOffset or 6
        local pos
        if typeof(target) == "Vector3" then pos = target
        else pos = Utils.positionOf(target) end
        if not pos then return false end
        pcall(function()
            hrp.CFrame = CFrame.new(pos + Vector3.new(0, heightOffset, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        return true
    end

    function Utils.touchActivation(activation, heightOffset)
        if not activation then return false end
        local hrp = Utils.getHRP()
        if not hrp then return false end
        heightOffset = heightOffset or Config.ActivationFallHeight
        local target = activation
        if activation:IsA("Folder") then
            local primary = activation:FindFirstChild("Root") or activation:FindFirstChild("Chest")
            if primary and primary:IsA("BasePart") then
                target = primary
            else
                for _, d in ipairs(activation:GetDescendants()) do
                    if d:IsA("BasePart") then target = d; break end
                end
            end
        end
        local pos = Utils.positionOf(target)
        if pos then
            pcall(function()
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, heightOffset, 0))
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        task.wait(0.1)
        if activation:IsA("BasePart") then
            pcall(function() activation.Touched:Fire(hrp) end)
        else
            for _, part in ipairs(activation:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.Touched:Fire(hrp) end)
                end
            end
        end
        task.wait(0.05)
        return true
    end

    -- ==================================================
    -- HOUSE SCANNING
    -- ==================================================
    local function isHouseReady(house)
        if not house then return false end
        local activation = house:FindFirstChild("Activation")
        if not activation then return false end
        local tag = activation:FindFirstChild("Tag")
        if not tag then return false end
        local billboard = tag:FindFirstChild("BillboardGui")
        if not billboard then return false end
        local label = billboard:FindFirstChild("Tag")
        if not label or not label:IsA("TextLabel") then return false end
        return label.Text == Config.HouseReadyText
    end

    local function scanHousesRaw()
        local houses = workspace:FindFirstChild("Houses")
        if not houses then return {}, 0 end
        local hrp = Utils.getHRP()
        local myPos = hrp and hrp.Position or Vector3.zero
        local ready = {}
        local total = 0
        for _, house in ipairs(houses:GetChildren()) do
            total += 1
            local activation = house:FindFirstChild("Activation")
            local root = activation and activation:FindFirstChild("Root")
            if root and root:IsA("BasePart") and isHouseReady(house) then
                local houseId = house:GetAttribute("HouseId") or house.Name
                table.insert(ready, {
                    house = house,
                    activation = activation,
                    root = root,
                    houseId = houseId,
                    distance = (root.Position - myPos).Magnitude,
                })
            end
        end
        table.sort(ready, function(a, b) return a.distance < b.distance end)
        return ready, total
    end

    local function scanHouses()
        if tick() - HouseScanCache.timestamp < Config.HouseScanCacheTTL then
            return HouseScanCache.result, HouseScanCache.total
        end
        local ready, total = scanHousesRaw()
        HouseScanCache.result = ready
        HouseScanCache.total = total
        HouseScanCache.timestamp = tick()
        return ready, total
    end

    local function attemptHouse(houseInfo)
        local candyBefore = CandycornBalance or 0
        Utils.touchActivation(houseInfo.activation)
        local deadline = tick() + Config.HouseConfirmWindow
        while tick() < deadline do
            if not _G.HalloweenEnabled then return false end
            if (CandycornBalance or 0) > candyBefore then
                SessionTrickOrTreats += 1
                HouseScanCache.timestamp = 0
                return true
            end
            task.wait(0.05)
        end
        Utils.touchActivation(houseInfo.activation)
        local deadline2 = tick() + Config.HouseRetryWindow
        while tick() < deadline2 do
            if not _G.HalloweenEnabled then return false end
            if (CandycornBalance or 0) > candyBefore then
                SessionTrickOrTreats += 1
                HouseScanCache.timestamp = 0
                return true
            end
            task.wait(0.05)
        end
        return false
    end

    -- ==================================================
    -- EGG HATCHING
    -- ==================================================
    local function ensureEggPlatform()
        if EggPlatform and EggPlatform.Parent then return EggPlatform end
        local eggs = workspace:FindFirstChild("Eggs")
        if not eggs then return nil end
        local egg = eggs:FindFirstChild(Config.EggName)
        if not egg then return nil end
        local eggPos = Utils.positionOf(egg)
        if not eggPos then return nil end
        local platform = Instance.new("Part")
        platform.Name = "_AutoHatchPlatform"
        platform.Size = Config.EggPlatformSize
        platform.Position = Vector3.new(eggPos.X, eggPos.Y + Config.EggPlatformYOffset, eggPos.Z)
        platform.Anchored = true
        platform.CanCollide = true
        platform.Transparency = 0
        platform.Color = Color3.fromRGB(150, 150, 150)
        platform.Material = Enum.Material.Slate
        platform.TopSurface = Enum.SurfaceType.Smooth
        platform.BottomSurface = Enum.SurfaceType.Smooth
        platform.Parent = workspace
        EggPlatform = platform
        return platform
    end

    local function getEggsOpened()
        local ls = player:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Eggs Opened")
        return v and v.Value or 0
    end

    local function releaseT()
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.T, false, game) end)
    end

    local function pressT()
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, Enum.KeyCode.T, false, game)
        end)
    end

    local function eggHatchHandler()
        local myGen = EggHatchGeneration
        local eggs = workspace:FindFirstChild("Eggs")
        if not eggs then task.wait(1); return false end
        local egg = eggs:FindFirstChild(Config.EggName)
        if not egg then task.wait(1); return false end
        local eggPos = Utils.positionOf(egg)
        if not eggPos then task.wait(1); return false end
        local platform = ensureEggPlatform()
        if not platform then task.wait(1); return false end
        local spawnPos = Vector3.new(
            eggPos.X,
            platform.Position.Y + platform.Size.Y / 2 + Config.EggVerticalOffset,
            eggPos.Z)
        Utils.teleportTo(spawnPos, 0)
        task.wait(0.4)
        pressT()
        local lastCount = getEggsOpened()
        local lastCheck = tick()
        local stalls = 0
        while _G.HalloweenEnabled and _G.HalloweenEggsEnabled do
            if EggHatchGeneration ~= myGen then
                releaseT(); return false
            end
            if #(scanHouses()) > 0 then
                releaseT(); return true
            end
            if tick() - lastCheck >= Config.EggCheckInterval then
                lastCheck = tick()
                local now = getEggsOpened()
                if now > lastCount then
                    SessionEggsHatched += (now - lastCount)
                    stalls = 0
                    lastCount = now
                else
                    stalls += 1
                    Utils.teleportTo(spawnPos, 0)
                    task.wait(0.3)
                    releaseT(); task.wait(0.1); pressT()
                    if stalls >= Config.EggStallLimit then
                        releaseT(); return false
                    end
                end
            end
            task.wait(0.5)
        end
        releaseT()
        return false
    end

    -- ==================================================
    -- MAIN LOOP
    -- ==================================================
    task.spawn(function()
        while true do
            while not _G.HalloweenEnabled do
                task.wait(0.5)
            end
            local loopOk = pcall(function()
                while _G.HalloweenEnabled do
                    local ready = scanHouses()
                    if #ready > 0 then
                        CurrentHouseId = ready[1].houseId
                        if not attemptHouse(ready[1]) then task.wait(0.5) end
                    else
                        CurrentHouseId = nil
                        if _G.HalloweenEggsEnabled then
                            eggHatchHandler()
                        else
                            task.wait(1)
                        end
                    end
                    task.wait(Config.LoopDelay)
                end
            end)
            if not loopOk then task.wait(5) end
            CurrentHouseId = nil
        end
    end)

end)

if not ok then
