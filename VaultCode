        if index == Config.PotionDataIndex and type(value) == "table" then
            pcall(function()
                local newCache = {}
                local count = 0
                for _, entry in ipairs(value) do
                    if type(entry) == "table"
                        and type(entry[1]) == "string"
                        and type(entry[2]) == "string" then
                        newCache[entry[1]] = entry[2]
                        count += 1
                    end
                end
                PotionCache = newCache
                PotionCount = count
                updateCheckboxVisuals()
                sweepAutoDeleteTypes()
                if PotionCount >= Config.PotionMaxSlots then
                    deleteForSpace()
                end
            end)
        end

        if index == Config.CandycornDataIndex and type(value) == "number" then
            CandycornBalance = value
        end
    end)

