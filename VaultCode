-- ==================================================
-- HALLOWEEN AUTO TRICK-OR-TREAT — FULL SCRIPT (v24)
-- Auto Spin + Auto Delete + Auto-Delete +1s + Delete-on-Full
-- All ON by default. Everything wrapped in pcall so nothing
-- can crash the client if the game state changes.
-- ==================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- ==================================================
-- STEP 1: AUTO LOW DETAIL CLICKER (silent)
-- ==================================================
do
    local Players = game:GetService("Players")
    local GuiService = game:GetService("GuiService")
    local VIM = game:GetService("VirtualInputManager")
    local player = Players.LocalPlayer

    local function getQualityFrame()
        local ok, frame = pcall(function()
            return player.PlayerGui.ClientScript.Modules.LoadingScreen.Screen.Quality
        end)
        if ok and frame then return frame end
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            for _, obj in ipairs(pg:GetDescendants()) do
                if obj.Name == "Quality" and obj:IsA("Frame") then return obj end
            end
        end
    end

    local function tap(key, hold)
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(hold or 0.05)
        VIM:SendKeyEvent(false, key, false, game)
    end

    local function clickAt(btn)
        pcall(function()
            local vu = game:GetService("VirtualUser")
            local c = Vector2.new(
                btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2,
                btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2)
            vu:Button1Down(c); task.wait(0.08); vu:Button1Up(c)
        end)
    end

    task.wait(15)
    local quality = nil
    for _ = 1, 30 do
        quality = getQualityFrame()
        if quality then break end
        task.wait(1)
    end

    if quality then
        local high = quality:FindFirstChild("HighQuality")
        local low  = quality:FindFirstChild("LowQuality")
        if low then
            task.wait(0.5)
            if high then pcall(function() GuiService.SelectedObject = high end); task.wait(0.3) end
            tap(Enum.KeyCode.Right); task.wait(0.25)
            tap(Enum.KeyCode.Right); task.wait(0.3)
            tap(Enum.KeyCode.Return, 0.08); task.wait(0.2)
            tap(Enum.KeyCode.KeypadEnter, 0.08); task.wait(0.2)
            clickAt(low); task.wait(0.1)
            pcall(function() low.MouseButton1Click:Fire() end)
            pcall(function() low.Activated:Fire() end)
            task.wait(0.5)
            tap(Enum.KeyCode.BackSlash)
        end
    end
end

